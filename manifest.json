{
  "manifest_version": 3,
  "name": "Seguidores - SBCL 🇧🇷",
  "version": "1.1.0",
  "description": "Mostra quais líderes estudantis você ainda não segue e quem já te seguiu de volta no AWS Builder Center.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://builder.aws.com/*",
    "https://www.lideresestudantis.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://builder.aws.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
